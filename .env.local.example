# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# --- Supabase ---
# Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Server-only. NEVER expose this. Used to bypass RLS for trusted server actions
# (single-user app). Find it in Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Storage bucket name (create this in Supabase Storage; can be private)
SUPABASE_STORAGE_BUCKET=items

# --- Auth ---
# Long random passphrase that unlocks the app from /login.
# Generate one and keep it private. Example: 4-6 random words.
APP_PASSCODE=change-me-to-a-long-random-passphrase

# 32+ character random secret used to sign the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-char-random-hex-string

# --- App ---
NEXT_PUBLIC_APP_NAME=Stash
